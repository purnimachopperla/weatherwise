# ─────────────────────────────────────────────
# WeatherWise Frontend — Environment Variables
# ─────────────────────────────────────────────

# In local development:
# Leaving this blank or setting to http://localhost:8000 allows Vite dev server to proxy /api
VITE_API_BASE_URL=http://localhost:8000

# In production deployment (e.g. Vercel, Netlify):
# Set this to the public URL of your deployed backend (e.g. https://your-backend.onrender.com)
# VITE_API_BASE_URL=https://your-backend-api-url.com
