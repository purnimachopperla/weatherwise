# ─────────────────────────────────────────────
# WeatherWise Frontend — Environment Variables
# ─────────────────────────────────────────────

# In local development:
# Leaving this blank or setting to http://localhost:8000 allows Vite dev server to proxy /api
VITE_API_URL=http://localhost:8000

# In production deployment (e.g. Vercel, Netlify):
# Set this to the public URL of your deployed backend on Render:
# VITE_API_URL=https://weatherwise-api.onrender.com
