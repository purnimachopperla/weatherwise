# ─────────────────────────────────────────────
# WeatherWise Backend — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values:
# cp .env.example .env
# NEVER commit the .env file to Git.

# --- Server Settings ---
# Python version for Render / cloud deployment:
PYTHON_VERSION=3.11.11

# Port for the backend server (automatically provided by cloud hosts like Render/Heroku)
PORT=8000

# The environment the app runs in: "development" or "production"
APP_ENV=development

# --- CORS Configuration ---
# Allowed origins for CORS (comma-separated for multiple origins)
# In local development, allow both Vite default ports:
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database ---
# SQLite database file path (relative to backend/)
DATABASE_URL=sqlite:///./weatherwise.db
# For production PostgreSQL (e.g. Supabase/Neon/Render Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- External APIs ---
# Open-Meteo is FREE and requires NO API key.
# The URLs below are the defaults. You only need to change them if using a custom proxy/mirror.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
